<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="768.0"
            prefWidth="1365.0"
            stylesheets="@style.css"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="DashboardController">

    <children>

        <StackPane prefHeight="768.0"
                   prefWidth="1365.0">

            <children>

                <ImageView fitHeight="768.0"
                           fitWidth="1365.0"
                           preserveRatio="false">

                    <image>
                        <Image url="@images/Background.png"/>
                    </image>

                </ImageView>


                <VBox alignment="TOP_CENTER"
                      prefWidth="1365.0"
                      spacing="18.0">

                    <padding>
                        <Insets top="25.0"/>
                    </padding>


                    <VBox alignment="CENTER"
                          spacing="10.0">

                        <StackPane styleClass="logo-circle">

                            <ImageView fitHeight="60.0"
                                       fitWidth="60.0"
                                       opacity="0.65"
                                       preserveRatio="true">

                                <image>
                                    <Image url="@images/train.jpeg"/>
                                </image>

                            </ImageView>

                        </StackPane>


                        <Label styleClass="main-title"
                               text="Online Reservation System"/>

                        <Label styleClass="subtitle"
                               text="Welcome to your journey dashboard"/>

                    </VBox>


                    <VBox maxWidth="600.0"
                          spacing="16.0"
                          styleClass="login-card">

                        <padding>
                            <Insets bottom="30.0"
                                    left="34.0"
                                    right="34.0"
                                    top="30.0"/>
                        </padding>


                        <HBox alignment="CENTER"
                              spacing="10.0">

                            <ImageView fitHeight="24.0"
                                       fitWidth="24.0"
                                       opacity="0.53">

                                <image>
                                    <Image url="@images/user.jpeg"/>
                                </image>

                            </ImageView>

                            <Label styleClass="card-title"
                                   text="Welcome to Dashboard"/>

                        </HBox>


                        <Separator/>


                        <VBox alignment="CENTER"
                              spacing="8.0">

                            <Label styleClass="field-title"
                                   text="What would you like to do?"/>

                            <Label styleClass="footer-text"
                                   text="Choose an option below to continue."/>

                        </VBox>


                        <Button fx:id="reservationButton"
                                onAction="#openReservation"
                                maxWidth="Infinity"
                                prefHeight="52.0"
                                styleClass="signin-button"
                                text="Make a Reservation"
                                textFill="WHITE"/>


                        <Button fx:id="cancellationButton"
                                onAction="#openCancellation"
                                maxWidth="Infinity"
                                prefHeight="52.0"
                                styleClass="signin-button"
                                text="Cancel a Ticket"
                                textFill="WHITE"/>


                        <HBox alignment="CENTER"
                              spacing="12.0">

                            <Separator HBox.hgrow="ALWAYS"/>

                            <Label styleClass="or-text"
                                   text="or"/>

                            <Separator HBox.hgrow="ALWAYS"/>

                        </HBox>


                        <HBox alignment="CENTER">

                            <Button fx:id="logoutButton"
                                    onAction="#logout"
                                    styleClass="back-button"
                                    text="Logout"/>

                        </HBox>

                    </VBox>


                    <HBox alignment="CENTER"
                          spacing="10.0">

                        <ImageView fitHeight="18.0"
                                   fitWidth="18.0">

                            <image>
                                <Image url="@images/sheild.jpeg"/>
                            </image>

                        </ImageView>

                        <Label styleClass="footer-text"
                               text="Secure Dashboard"/>

                        <Label styleClass="footer-text"
                               text="|"/>

                        <Label styleClass="footer-text"
                               text="Your information is safe with us"/>

                    </HBox>

                </VBox>

            </children>

        </StackPane>

    </children>

</AnchorPane>

