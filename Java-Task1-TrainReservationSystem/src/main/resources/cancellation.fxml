<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="768.0"
            prefWidth="1365.0"
            stylesheets="@style.css"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="CancellationController">

    <children>

        <!-- BACKGROUND -->

        <StackPane prefHeight="768.0"
                   prefWidth="1365.0">

            <children>

                <ImageView fitHeight="768.0"
                           fitWidth="1365.0"
                           preserveRatio="false">

                    <image>
                        <Image url="@images/Background.png"/>
                    </image>

                </ImageView>


                <!-- MAIN CONTENT -->

                <VBox alignment="TOP_CENTER"
                      prefWidth="1365.0"
                      spacing="18.0">

                    <padding>
                        <Insets top="25.0"/>
                    </padding>


                    <!-- LOGO -->

                    <VBox alignment="CENTER"
                          spacing="10.0">

                        <StackPane styleClass="logo-circle">

                            <ImageView fitHeight="60.0"
                                       fitWidth="60.0"
                                       opacity="0.65"
                                       preserveRatio="true">

                                <image>
                                    <Image url="@images/train.jpeg"/>
                                </image>

                            </ImageView>

                        </StackPane>


                        <Label styleClass="main-title"
                               text="Online Reservation System"/>


                        <Label styleClass="subtitle"
                               text="Cancel your journey"/>

                    </VBox>


                    <!-- CANCELLATION CARD -->

                    <VBox maxWidth="600.0"
                          spacing="14.0"
                          styleClass="login-card">

                        <padding>
                            <Insets bottom="25.0"
                                    left="34.0"
                                    right="34.0"
                                    top="25.0"/>
                        </padding>


                        <!-- CARD TITLE -->

                        <HBox alignment="CENTER"
                              spacing="10.0">

                            <ImageView fitHeight="24.0"
                                       fitWidth="24.0"
                                       opacity="0.53">

                                <image>
                                    <Image url="@images/train.jpeg"/>
                                </image>

                            </ImageView>


                            <Label styleClass="card-title"
                                   text="Cancel Ticket"/>

                        </HBox>


                        <Separator/>


                        <!-- PNR -->

                        <VBox spacing="6.0">

                            <Label styleClass="field-title"
                                   text="PNR Number"/>


                            <HBox alignment="CENTER_LEFT"
                                  spacing="12.0"
                                  styleClass="input-container">

                                <ImageView fitHeight="20.0"
                                           fitWidth="20.0">

                                    <image>
                                        <Image url="@images/train.jpeg"/>
                                    </image>

                                </ImageView>


                                <TextField fx:id="pnrField"
                                           promptText="Enter PNR number"
                                           styleClass="text-field-custom"
                                           HBox.hgrow="ALWAYS"/>

                            </HBox>

                        </VBox>


                        <!-- FETCH BUTTON -->

                       <Button fx:id="fetchButton" onAction="#fetchBooking" maxWidth="Infinity" prefHeight="45.0" styleClass="signin-button" text="Fetch Booking" textFill="WHITE"/>

                        <!-- BOOKING DETAILS -->

                        <VBox fx:id="bookingDetailsBox"
                              spacing="8.0"
                              visible="false"
                              managed="false"
                              styleClass="booking-details-box">

                            <Label styleClass="field-title"
                                   text="Booking Details"/>

                            <Separator/>


                            <HBox spacing="10.0">

                                <Label text="Passenger:"
                                       styleClass="detail-label"/>

                                <Label fx:id="passengerLabel"
                                       text="-"
                                       styleClass="detail-value"/>

                            </HBox>


                            <HBox spacing="10.0">

                                <Label text="Train:"
                                       styleClass="detail-label"/>

                                <Label fx:id="trainLabel"
                                       text="-"
                                       styleClass="detail-value"/>

                            </HBox>


                            <HBox spacing="10.0">

                                <Label text="Journey Date:"
                                       styleClass="detail-label"/>

                                <Label fx:id="dateLabel"
                                       text="-"
                                       styleClass="detail-value"/>

                            </HBox>


                            <HBox spacing="10.0">

                                <Label text="Source:"
                                       styleClass="detail-label"/>

                                <Label fx:id="sourceLabel"
                                       text="-"
                                       styleClass="detail-value"/>

                            </HBox>


                            <HBox spacing="10.0">

                                <Label text="Destination:"
                                       styleClass="detail-label"/>

                                <Label fx:id="destinationLabel"
                                       text="-"
                                       styleClass="detail-value"/>

                            </HBox>


                            <HBox spacing="10.0">

                                <Label text="Class:"
                                       styleClass="detail-label"/>

                                <Label fx:id="classLabel"
                                       text="-"
                                       styleClass="detail-value"/>

                            </HBox>

                        </VBox>


                        <!-- CANCEL BUTTON -->

                     <Button fx:id="cancelButton" onAction="#cancelTicket" maxWidth="Infinity" prefHeight="48.0" styleClass="signin-button" text="Cancel Ticket" textFill="WHITE"/>


                        <!-- SEPARATOR -->

                        <HBox alignment="CENTER"
                              spacing="12.0">

                            <Separator HBox.hgrow="ALWAYS"/>

                            <Label styleClass="or-text"
                                   text="or"/>

                            <Separator HBox.hgrow="ALWAYS"/>

                        </HBox>


                        <!-- BACK BUTTON -->

                        <HBox alignment="CENTER">

                           <Button fx:id="backButton" onAction="#goBack" styleClass="back-button" text="← Back to Dashboard"/>

                        </HBox>

                    </VBox>


                    <!-- FOOTER -->

                    <HBox alignment="CENTER"
                          spacing="10.0">

                        <ImageView fitHeight="18.0"
                                   fitWidth="18.0">

                            <image>
                                <Image url="@images/sheild.jpeg"/>
                            </image>

                        </ImageView>


                        <Label styleClass="footer-text"
                               text="Secure Cancellation"/>

                        <Label styleClass="footer-text"
                               text="|"/>

                        <Label styleClass="footer-text"
                               text="Your information is safe with us"/>

                    </HBox>

                </VBox>

            </children>

        </StackPane>

    </children>

</AnchorPane>
